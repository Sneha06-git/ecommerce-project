<%- include("../partials/header", { title: "Customers | E-Commerce" }) %>

<body>

    <div class="container py-5">

        <!-- HEADER -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>Customers</h1>

                <p class="text-muted mb-0">
                    View registered customers.
                </p>

            </div>


            <a
                href="/admin/dashboard"
                class="btn btn-dark"
            >

                <i class="fa-solid fa-arrow-left"></i>

                Dashboard

            </a>

        </div>


        <% if (customers.length === 0) { %>

            <div class="alert alert-info">

                No customers have registered yet.

            </div>

        <% } else { %>


            <!-- CUSTOMER TABLE -->

            <div class="card admin-customers-card">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th>Name</th>

                                <th>Email</th>

                                <th>Phone</th>

                                <th>Address</th>

                                <th>Registered On</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% customers.forEach((customer) => { %>

                                <tr>

                                    <td>

                                        <strong>
                                            <%= customer.name %>
                                        </strong>

                                    </td>


                                    <td>
                                        <%= customer.email %>
                                    </td>


                                    <td>
                                        <%= customer.phone %>
                                    </td>


                                    <td>
                                        <%= customer.address %>
                                    </td>


                                    <td>

                                        <%= new Date(
                                            customer.createdAt
                                        ).toLocaleDateString() %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>


        <% } %>

    </div>

</body>

</html>