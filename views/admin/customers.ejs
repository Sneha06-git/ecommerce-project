<%- include("../partials/header", { title: "Customers | Admin" }) %>

<body>

    <!-- =========================
         ADMIN NAVBAR
    ========================= -->
    <nav class="admin-navbar">
        <div class="container">
            <div class="admin-navbar-content">

                <a href="/admin/dashboard" class="admin-brand">
                    <i class="fa-solid fa-store"></i>
                    E-Commerce Admin
                </a>

                <div class="admin-nav-actions">
                    <a href="/admin/dashboard" class="admin-back-btn">
                        <i class="fa-solid fa-arrow-left"></i>
                        Dashboard
                    </a>

                    <a href="/auth/logout" class="admin-logout-btn">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </a>
                </div>

            </div>
        </div>
    </nav>

    <!-- =========================
         CUSTOMERS HERO
    ========================= -->
    <section class="admin-page-hero">
        <div class="container">

            <div class="admin-page-heading">

                <span class="admin-page-badge">
                    <i class="fa-solid fa-users"></i>
                    Customer Management
                </span>

                <h1>Customers</h1>

                <p>
                    View the registered customers of your
                    e-commerce store.
                </p>

            </div>

        </div>
    </section>

    <!-- =========================
         CUSTOMERS CONTENT
    ========================= -->
    <section class="admin-customers-content">
        <div class="container">

            <% if (customers.length === 0) { %>

                <!-- =========================
                     EMPTY CUSTOMERS
                ========================= -->
                <div class="admin-customers-empty">

                    <div class="admin-customers-empty-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h3>No Customers Yet</h3>

                    <p>
                        No customers have registered on your
                        store yet.
                    </p>

                </div>

            <% } else { %>

                <!-- =========================
                     CUSTOMERS HEADER
                ========================= -->
                <div class="admin-customers-topbar">

                    <div>
                        <h2>Registered Customers</h2>
                        <p>
                            <%= customers.length %> customer(s) registered
                        </p>
                    </div>

                </div>

                <!-- =========================
                     CUSTOMER TABLE
                ========================= -->
                <div class="admin-customers-card">

                    <div class="table-responsive">

                        <table class="admin-customers-table">

                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Registered On</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% customers.forEach((customer) => { %>

                                    <tr>

                                        <!-- CUSTOMER -->
                                        <td>
                                            <div class="admin-customer-info">

                                                <div class="admin-customer-avatar">
                                                    <i class="fa-solid fa-user"></i>
                                                </div>

                                                <div>
                                                    <strong>
                                                        <%= customer.name %>
                                                    </strong>

                                                    <span>
                                                        Customer
                                                    </span>
                                                </div>

                                            </div>
                                        </td>

                                        <!-- EMAIL -->
                                        <td>
                                            <span class="admin-customer-email">
                                                <i class="fa-solid fa-envelope"></i>
                                                <%= customer.email %>
                                            </span>
                                        </td>

                                        <!-- PHONE -->
                                        <td>
                                            <span class="admin-customer-phone">
                                                <i class="fa-solid fa-phone"></i>
                                                <%= customer.phone %>
                                            </span>
                                        </td>

                                        <!-- ADDRESS -->
                                        <td>
                                            <span class="admin-customer-address">
                                                <%= customer.address %>
                                            </span>
                                        </td>

                                        <!-- DATE -->
                                        <td>
                                            <span class="admin-customer-date">
                                                <i class="fa-regular fa-calendar"></i>
                                                <%= new Date(
                                                    customer.createdAt
                                                ).toLocaleDateString() %>
                                            </span>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            <% } %>

        </div>
    </section>

</body>
</html>