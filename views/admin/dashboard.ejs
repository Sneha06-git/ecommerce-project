<%- include("../partials/header", { title: "Admin Dashboard | E-Commerce" }) %>

<body>
    <!-- =========================
         ADMIN NAVBAR
    ========================= -->
    <nav class="admin-navbar">
        <div class="container">
            <div class="admin-navbar-content">

                <a href="/admin/dashboard" class="admin-brand">
                    <i class="fa-solid fa-store"></i>
                    E-Commerce Admin
                </a>

                <a href="/auth/logout" class="admin-logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>

            </div>
        </div>
    </nav>

    <!-- =========================
         ADMIN DASHBOARD HERO
    ========================= -->
    <section class="admin-dashboard-hero">
        <div class="container">

            <div class="admin-dashboard-welcome">

                <span class="admin-dashboard-badge">
                    <i class="fa-solid fa-shield-halved"></i>
                    Admin Panel
                </span>

                <h1>
                    Welcome, <%= userName %> 👋
                </h1>

                <p>
                    Manage your products, customers and orders
                    from one place.
                </p>

            </div>

        </div>
    </section>

    <!-- =========================
         ADMIN DASHBOARD ACTIONS
    ========================= -->
    <section class="admin-dashboard-content">
        <div class="container">

            <div class="admin-section-heading">
                <h2>Management</h2>
                <p>
                    Choose a section to manage your e-commerce store.
                </p>
            </div>

            <div class="row g-4">

                <!-- PRODUCTS -->
                <div class="col-md-6 col-xl-3">
                    <a
                        href="/admin/products"
                        class="admin-dashboard-card-link"
                    >
                        <div class="admin-dashboard-card">

                            <div class="admin-dashboard-card-icon">
                                <i class="fa-solid fa-box-open"></i>
                            </div>

                            <h3>Products</h3>

                            <p>
                                View and manage products available
                                in your store.
                            </p>

                            <span class="admin-dashboard-card-link-text">
                                Manage Products
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>
                    </a>
                </div>

                <!-- ADD PRODUCT -->
                <div class="col-md-6 col-xl-3">
                    <a
                        href="/admin/add-product"
                        class="admin-dashboard-card-link"
                    >
                        <div class="admin-dashboard-card">

                            <div class="admin-dashboard-card-icon">
                                <i class="fa-solid fa-plus"></i>
                            </div>

                            <h3>Add Product</h3>

                            <p>
                                Add a new product to your
                                e-commerce store.
                            </p>

                            <span class="admin-dashboard-card-link-text">
                                Add Product
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>
                    </a>
                </div>

                <!-- CUSTOMERS -->
                <div class="col-md-6 col-xl-3">
                    <a
                        href="/admin/customers"
                        class="admin-dashboard-card-link"
                    >
                        <div class="admin-dashboard-card">

                            <div class="admin-dashboard-card-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <h3>Customers</h3>

                            <p>
                                View registered customers and
                                their account information.
                            </p>

                            <span class="admin-dashboard-card-link-text">
                                View Customers
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>
                    </a>
                </div>

                <!-- ORDERS -->
                <div class="col-md-6 col-xl-3">
                    <a
                        href="/admin/orders"
                        class="admin-dashboard-card-link"
                    >
                        <div class="admin-dashboard-card">

                            <div class="admin-dashboard-card-icon">
                                <i class="fa-solid fa-truck"></i>
                            </div>

                            <h3>Orders</h3>

                            <p>
                                View orders and update their
                                current status.
                            </p>

                            <span class="admin-dashboard-card-link-text">
                                Manage Orders
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>
                    </a>
                </div>

            </div>

        </div>
    </section>

</body>
</html>