<%- include("../partials/header", { title: "Products | E-Commerce" }) %>

<body>

    <%- include("../partials/navbar") %>

    <div class="container py-5">

        <div class="text-center mb-5">

            <h1>Our Products</h1>

            <p class="text-muted">
                Explore our collection and find what you need.
            </p>

        </div>
        
        <div class="row g-3 mb-4">

    <div class="col-md-7">

        <div class="input-group">

            <span class="input-group-text">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>

            <input
                type="text"
                id="productSearch"
                class="form-control"
                placeholder="Search products..."
            >

        </div>

    </div>

    <div class="col-md-3">

        <select
            id="categoryFilter"
            class="form-select"
        >

            <option value="all">
                All Categories
            </option>

            <% 
                const categories = [
                    ...new Set(products.map(product => product.category))
                ];
            %>

            <% categories.forEach((category) => { %>

                <option value="<%= category %>">
                    <%= category %>
                </option>

            <% }) %>

        </select>

    </div>

         <div class="col-md-2">

        <button
            type="button"
            id="clearFilters"
            class="btn btn-outline-secondary w-100"
        >
            Clear
        </button>

        </div>

        </div>
        <div
        id="noProductsMessage"
        class="alert alert-info text-center d-none"
            >
        No products found matching your search.
</div>
        <div class="row g-4">

            <% if (products.length === 0) { %>

                <div class="col-12">

                    <div class="alert alert-info text-center">
                        No products available right now.
                    </div>

                </div>

            <% } %>


            <% products.forEach((product) => { %>

                <div
                 class="col-md-6 col-lg-4 product-item"
                 data-name="<%= product.name.toLowerCase() %>"
                 data-category="<%= product.category.toLowerCase() %>"
                >
                    <a
                        href="/products/<%= product._id %>"
                        class="product-card-link"
                    >

                        <div class="card h-100 product-listing-card">

                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                               class="product-listing-image"
                            >

                            <div class="card-body product-listing-body">

                               <h5 class="card-title product-listing-name">
                                    <%= product.name %>
                                </h5>

                                <p class="product-listing-category">
                                    <%= product.category %>
                                </p>

                                <h5 class="product-card-price product-listing-price">
                                    ₹<%= product.price %>
                                </h5>

                                <% if (product.stock > 0) { %>

                                    <span class="badge bg-success">
                                        In Stock
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>

                                <% } %>

                                 <div class="product-listing-button">

                                    <span class="btn btn-outline-primary btn-sm">
                                    View Product
                                    </span>

                                 </div>

                            </div>

                           

                        </div>

                    </a>

                </div>

            <% }) %>

        </div>

    </div>
    
    <script src="/js/main.js"></script>

</body>
</html>