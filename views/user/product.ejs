<%- include("../partials/header", { title: product.name + " | E-Commerce" }) %>

<body>

    <%- include("../partials/navbar") %>

    <div class="container py-5">

        <div class="row g-5">

            <!-- Product Image -->
            <div class="col-md-6">

                <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                    class="product-detail-image"
                >

            </div>

            <!-- Product Information -->
            <div class="col-md-6">

                <h1 class="product-detail-title">
                    <%= product.name %>
                </h1>

                <p class="product-detail-category">
                    Category: <%= product.category %>
                </p>

                <h2 class="product-detail-price">
                    ₹<%= product.price %>
                </h2>

                <p class="product-detail-description">
                    <%= product.description %>
                </p>

                <p>
                    <strong>Available Stock:</strong>

                    <span id="availableStock">
                    <%= product.stock - cartQuantity %>
                    </span>
                </p>

               <form id="addToCartForm">

    <input
        type="hidden"
        name="productId"
        value="<%= product._id %>"
    >

   <div class="quantity-selector">

    <button
        type="button"
        id="decreaseQuantity"
        class="quantity-btn"
    >
        −
    </button>

    <input
        type="number"
        id="productQuantity"
        name="quantity"
        value="1"
        min="1"
        max="<%= product.stock - cartQuantity %>"
        readonly
    >

    <button
        type="button"
        id="increaseQuantity"
        class="quantity-btn"
    >
        +
    </button>

</div>

    <button
    type="submit"
    class="btn btn-primary add-to-cart-button"
    id="addToCartButton"
    <%= (product.stock - cartQuantity) <= 0 ? "disabled" : "" %>
>
    <i class="fa-solid fa-cart-plus"></i>
    Add to Cart
</button>

</form>

    <div
    id="cartMessage"
    class="mt-3"
    >
    </div>
        <p
          id="stockMessage"
          class="mt-2"
        >
        </p>
            </div>

        </div>

    </div>
<script src="/js/cart.js"></script>
</body>
</html>