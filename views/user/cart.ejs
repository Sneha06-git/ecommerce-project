<%- include("../partials/header", { title: "My Cart | E-Commerce" }) %>

<body>

    <%- include("../partials/navbar") %>


    <div class="container py-5">

        <h1 class="mb-4">My Cart</h1>


        <% if (!cart || cart.products.length === 0) { %>

            <div class="alert alert-info">
                Your cart is empty.
            </div>

            <a
                href="/products"
                class="btn btn-primary"
            >
                Continue Shopping
            </a>


        <% } else { %>


            <div class="row g-4">


                <!-- CART PRODUCTS -->

                <div class="col-lg-8">

                    <% cart.products.forEach((item) => { %>

                        <div
                            class="card mb-3 cart-item"
                            data-product-id="<%= item.product._id %>"
                            data-stock="<%= item.product.stock %>"
                        >

                            <div class="card-body">

                                <div class="row align-items-center">


                                    <!-- IMAGE -->

                                    <div class="col-md-3">

                                        <img
                                            src="<%= item.product.image %>"
                                            alt="<%= item.product.name %>"
                                            class="cart-product-image"
                                        >

                                    </div>


                                    <!-- PRODUCT DETAILS -->

                                    <div class="col-md-4">

                                        <h5 class="cart-product-name">
                                            <%= item.product.name %>
                                        </h5>

                                        <p class="text-muted mb-2">
                                            <%= item.product.category %>
                                        </p>

                                        <p class="cart-product-price mb-0">
                                            ₹<%= item.product.price %>
                                        </p>

                                    </div>


                                    <!-- QUANTITY -->

                                    <div class="col-md-3">

                                        <div class="cart-quantity-selector">

                                            <button
                                                type="button"
                                                class="cart-quantity-btn decrease-cart"
                                            >
                                                −
                                            </button>

                                            <span class="cart-quantity">
                                                <%= item.quantity %>
                                            </span>

                                            <button
                                                type="button"
                                                class="cart-quantity-btn increase-cart"
                                            >
                                                +
                                            </button>

                                        </div>


                                        <button
                                            type="button"
                                            class="remove-cart-item"
                                            title="Remove from cart"
                                        >
                                            <i class="fa-solid fa-trash-can"></i>
                                            <span>Remove</span>
                                        </button>

                                    </div>


                                    <!-- SUBTOTAL -->

                                    <div class="col-md-2 text-md-end">

                                        <strong class="cart-item-subtotal">
                                            ₹<%= item.product.price * item.quantity %>
                                        </strong>

                                    </div>


                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>


                <!-- CART SUMMARY -->

                <div class="col-lg-4">

                    <div class="card cart-summary">

                        <div class="card-body">

                            <h4 class="mb-4">
                                Order Summary
                            </h4>


                            <div class="d-flex justify-content-between mb-3">

                                <span>
                                    Items
                                </span>

                                <span id="cartTotalItems">
                                    <%= cart.products.reduce(
                                        (total, item) =>
                                            total + item.quantity,
                                        0
                                    ) %>
                                </span>

                            </div>


                            <div class="d-flex justify-content-between mb-3">

                                <span>
                                    Subtotal
                                </span>

                                <span id="cartTotalPrice">

                                    ₹<%= cart.products.reduce(
                                        (total, item) =>
                                            total +
                                            (item.product.price * item.quantity),
                                        0
                                    ) %>

                                </span>

                            </div>


                            <hr>


                            <div class="d-flex justify-content-between mb-4">

                                <strong>
                                    Total
                                </strong>

                                <strong id="cartGrandTotal">

                                    ₹<%= cart.products.reduce(
                                        (total, item) =>
                                            total +
                                            (item.product.price * item.quantity),
                                        0
                                    ) %>

                                </strong>

                            </div>


                            <a
                                href="/orders/checkout"
                                class="btn btn-primary w-100"
                            >
                                Proceed to Checkout
                            </a>


                        </div>

                    </div>

                </div>


            </div>


        <% } %>

    </div>


    <script src="/js/cart.js"></script>

</body>
</html>